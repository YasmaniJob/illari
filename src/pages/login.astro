---
import LoginForm from '@/features/auth/client/LoginForm';
import BaseLayout from '@/shared/client/layouts/BaseLayout.astro';

const redirect = Astro.url.searchParams.get('redirect') ?? '/';
const initialMode = Astro.url.searchParams.has('register') ? 'register' : 'login';
---

<BaseLayout title="Mi Wawita — Iniciar sesión">
  <div class="flex min-h-[70vh] items-center justify-center py-10">
    <LoginForm client:load redirectTo={redirect} initialMode={initialMode} />
  </div>
</BaseLayout>
