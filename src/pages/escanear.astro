---
import { parseCurriculumCsv } from '@/features/curriculum/curriculum';
import curriculoRaw from '@/features/curriculum/data/curriculo.csv?raw';
import ScanSessionFlow from '@/features/scan/client/components/ScanSessionFlow';
import BaseLayout from '@/shared/client/layouts/BaseLayout.astro';

const curriculum = parseCurriculumCsv(curriculoRaw);
---

<BaseLayout title="Mi Wawita — Escanear sesión" fixedViewport>
  <div class="h-full min-h-0">
    <ScanSessionFlow client:load curriculum={curriculum} />
  </div>
</BaseLayout>
