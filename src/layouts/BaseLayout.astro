---
import '../styles/global.css';
import DecorativeBlobs from '../components/ui/DecorativeBlobs.astro';
import AuthHeader from '../components/layout/AuthHeader';

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  /** Pantalla fija sin scroll (onboarding) */
  fixedViewport?: boolean;
  /** Layout enmarcado: canvas pastel + marco blanco centrado, sin scroll */
  boxed?: boolean;
}

const {
  title = 'Illari — Cuaderno de Campo',
  description = 'Cuaderno de campo digital para educación inicial.',
  fullWidth = false,
  fixedViewport = false,
  boxed = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class:list={[
      boxed
        ? 'h-dvh overflow-hidden bg-gradient-to-br from-lilac-100/40 via-cream to-honey-200/30'
        : fixedViewport
          ? 'h-dvh overflow-hidden'
          : 'min-h-screen',
    ]}
  >
    {!boxed && <DecorativeBlobs />}

    {boxed ? (
      /* ── BOXED LAYOUT: canvas pastel + marco blanco ── */
      <div class="h-dvh flex flex-col items-center justify-center px-4 py-4">
        <div class="w-full max-w-[1200px] h-full max-h-[820px] bg-white rounded-3xl shadow-[0_8px_40px_-8px_rgba(61,44,41,0.14)] flex flex-col overflow-hidden">

          {/* Navbar dentro del marco */}
          <header class="shrink-0 h-16 border-b border-cream-dark bg-gradient-to-r from-white via-cream to-honey-200/30 px-6 sm:px-8 flex items-center">
            {/* Logo — izquierda */}
            <a
              href="/"
              class="flex items-center gap-3 min-w-0 transition-opacity duration-200 hover:opacity-85 focus-ring-warm rounded-xl -m-1 p-1"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-lilac-500 to-lilac-600 text-lg font-extrabold text-white shadow-[0_2px_10px_-2px_rgba(139,92,246,0.4)]"
              >
                I
              </span>
              <span class="text-xl font-extrabold text-warm-900 tracking-tight truncate">
                Illari
              </span>
            </a>
            {/* Título — centro absoluto */}
            <p class="absolute left-1/2 -translate-x-1/2 hidden sm:block text-sm font-semibold text-warm-700 pointer-events-none select-none">
              Cuaderno de Campo Digital
            </p>
            {/* Auth — derecha */}
            <div class="ml-auto">
              <AuthHeader client:load userName={Astro.locals.user?.name ?? null} />
            </div>
          </header>

          {/* Contenido principal dentro del marco */}
          <main class="flex-1 overflow-hidden">
            <slot />
          </main>

        </div>
      </div>
    ) : (
      /* ── LAYOUT ESTÁNDAR ── */
      <>
        <header
          class="sticky top-0 z-40 h-16 border-b border-cream-dark bg-gradient-to-r from-white via-cream to-honey-200/30 shadow-[0_2px_12px_-4px_rgba(224,122,95,0.12)]"
        >
          <div
            class:list={[
              'mx-auto h-full px-5 sm:px-8 flex items-center justify-between gap-3',
              fullWidth ? 'max-w-full' : 'max-w-5xl',
            ]}
          >
            <a
              href="/"
              class="flex items-center gap-3 min-w-0 transition-opacity duration-200 hover:opacity-85 focus-ring-warm rounded-xl -m-1 p-1"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-lilac-500 to-lilac-600 text-lg font-extrabold text-white shadow-[0_2px_10px_-2px_rgba(139,92,246,0.4)]"
              >
                I
              </span>
              <span class="text-xl font-extrabold text-warm-900 tracking-tight truncate">
                Illari
              </span>
            </a>
            <p class="hidden lg:block text-sm font-semibold text-warm-700 shrink-0">
              Cuaderno de Campo Digital
            </p>
            <AuthHeader client:load userName={Astro.locals.user?.name ?? null} />
          </div>
        </header>

        <main
          class:list={[
            'mx-auto',
            fixedViewport
              ? 'h-[calc(100dvh-4rem)] max-w-2xl w-full overflow-hidden px-5 py-4 sm:px-6'
              : [
                  'px-5 sm:px-8 py-10 sm:py-14 max-w-5xl',
                  fullWidth ? 'max-w-full min-h-[calc(100vh-4rem)] p-0 sm:p-0' : '',
                ],
          ]}
        >
          <slot />
        </main>
      </>
    )}
  </body>
</html>
